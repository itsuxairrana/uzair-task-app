{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uv-tasks",
  "main": "src-worker/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Google OAuth (public). GOOGLE_CLIENT_SECRET is a `wrangler secret`, never in this file.
  "vars": { "GOOGLE_CLIENT_ID": "1097007405347-c63ogrtumg2uub5cdndsjajpd1oneppq.apps.googleusercontent.com" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Browser navigations (e.g. Google's OAuth redirect to /api/google/callback) would
    // otherwise get the SPA's index.html instead of reaching the Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uv-task-db",
      "database_id": "5c772242-c59d-4228-b79e-78b87c873373"
    }
  ],
  // Task attachments (messages and work hand-ins).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "uv-task-files" }],
  // 14:00 UTC = 7pm Pakistan time: evening check on unfinished daily routines.
  "triggers": { "crons": ["0 14 * * *"] },
  "routes": [{ "pattern": "task.uzairvisuals.com", "custom_domain": true }]
}
